# =============================================================================
# NexusMarket - Plantilla de Variables de Entorno (.env.example)
# Copie este archivo a .env y reemplace TODOS los valores <REPLACE_WITH_...>
# por secretos criptograficamente seguros antes de iniciar en produccion/Docker.
# NUNCA suba el archivo .env con credenciales reales al repositorio Git.
# =============================================================================

# Puerto del Microservicio y Perfil Activo
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Base de Datos Relacional (Microsoft SQL Server 2022)
# Requisitos SQL Server: minimo 8 caracteres, mayusculas, minusculas, digitos y simbolos.
MSSQL_SA_PASSWORD=<REPLACE_WITH_STRONG_SQLSERVER_PASSWORD>
DB_URL=jdbc:sqlserver://nexusmarket-db:1433;databaseName=NexusMarket;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=<REPLACE_WITH_STRONG_SQLSERVER_PASSWORD>

# Variables estandar Spring Boot Datasource
SPRING_DATASOURCE_URL=jdbc:sqlserver://nexusmarket-db:1433;databaseName=NexusMarket;encrypt=true;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=<REPLACE_WITH_STRONG_SQLSERVER_PASSWORD>
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_SQL_INIT_MODE=always

# Base de Datos NoSQL de Auditoria (MongoDB 7.0)
MONGO_INITDB_ROOT_USERNAME=nexus_admin
MONGO_INITDB_ROOT_PASSWORD=<REPLACE_WITH_STRONG_MONGODB_PASSWORD>
MONGO_INITDB_DATABASE=nexusmarket_audit
SPRING_DATA_MONGODB_URI=mongodb://nexus_admin:<REPLACE_WITH_STRONG_MONGODB_PASSWORD>@nexusmarket-mongo:27017/nexusmarket_audit?authSource=admin

# Seguridad JWT (HMAC-SHA256 - obligatorio minimo 32 bytes / 256 bits)
# Ejemplo para generar: openssl rand -base64 48
SECURITY_JWT_SECRET=<REPLACE_WITH_256_BIT_CRYPTOGRAPHIC_JWT_SECRET_KEY>
SECURITY_JWT_EXPIRATION_SECONDS=86400

# Reglas Operativas
NEXUSMARKET_ORDERS_TTL_MINUTES=30
