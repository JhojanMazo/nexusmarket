# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Executable scripts
mvnw text eol=lf
mvnw.cmd text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
