# Java / Maven build artefacts
target/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Allow Maven Wrapper files in version control
!.mvn/wrapper/**
!nexusmarket/.mvn/wrapper/**

# Logs and diagnostics
*.log
hs_err_pid*
replay_pid*

# OS / IDE artefacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# Backups
*.bak
nexusmarket_backup/

# Node.js
node_modules/
package-lock.json

# Environment files (keep template .env.example versioned)
.env
.env.*
!.env.example
!nexusmarket/.env.example
